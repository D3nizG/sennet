# Server
PORT=3001
NODE_ENV=development

# Database
# Use a direct PostgreSQL connection locally.
# In production, DATABASE_URL is often the pooled URL and DIRECT_URL is the direct/non-pooled URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sennet?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sennet?schema=public"

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters

# CORS
CLIENT_URL=http://localhost:5173

# Supabase (Google OAuth sign-in)
# From Supabase dashboard → Project Settings → API. The anon key is enough to
# verify OAuth access tokens server-side. Leave blank to disable Google sign-in.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
